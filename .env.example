# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / anon public (sb_publishable_...). NUNCA sb_secret_
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo server (sin NEXT_PUBLIC_): sb_secret_...
SUPABASE_SERVICE_ROLE_KEY=

# Root domain
NEXT_PUBLIC_ROOT_DOMAIN=katem.store

# YCloud (transporte WhatsApp; la IA es OpenAI)
YCLOUD_API_KEY=
YCLOUD_WHATSAPP_FROM=+15553082749

# Handshake: siempre user_initiated (wa.me). No se envían plantillas desde el form.
WHATSAPP_HANDSHAKE_MODE=user_initiated

# LLM (agente que responde tras el primer mensaje del cliente)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
