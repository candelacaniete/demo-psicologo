# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / anon public (sb_publishable_... o anon JWT). NUNCA sb_secret_
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo server (sin NEXT_PUBLIC_): sb_secret_... / service_role
SUPABASE_SERVICE_ROLE_KEY=

# Root domain for subdomain tenancy (inmobiliaria.katem.store)
NEXT_PUBLIC_ROOT_DOMAIN=katem.store

# YCloud
YCLOUD_API_KEY=
YCLOUD_WHATSAPP_FROM=+15553082749

# Handshake DEFAULT: user_initiated
# Form → botón wa.me con mensaje precargado → cliente envía → ventana 24h → agente IA
# Opcional más adelante (pide display name Meta): WHATSAPP_HANDSHAKE_MODE=template
WHATSAPP_HANDSHAKE_MODE=user_initiated
YCLOUD_WELCOME_TEMPLATE_NAME=followuplead
YCLOUD_WELCOME_TEMPLATE_LANG=es
YCLOUD_WELCOME_TEMPLATE_CATEGORY=MARKETING

# LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
