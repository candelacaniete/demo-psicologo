# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# ⚠️ anon / public key (Settings → API → anon public). NUNCA la service_role acá.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo server (Vercel, no NEXT_PUBLIC_): service_role
SUPABASE_SERVICE_ROLE_KEY=

# Root domain for subdomain tenancy (inmobiliaria.katem.store)
NEXT_PUBLIC_ROOT_DOMAIN=katem.store

# YCloud
YCLOUD_API_KEY=
YCLOUD_WHATSAPP_FROM=+15553082749

# Handshake: template (default) = business inicia con plantilla aprobada
# Fallback automático a wa.me si el template falla o el lead es DISCARDED
WHATSAPP_HANDSHAKE_MODE=template
YCLOUD_WELCOME_TEMPLATE_NAME=followuplead
YCLOUD_WELCOME_TEMPLATE_LANG=es
# Meta category: MARKETING is fine for lead follow-up (Utility was preferred but not required)
YCLOUD_WELCOME_TEMPLATE_CATEGORY=MARKETING

# LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
