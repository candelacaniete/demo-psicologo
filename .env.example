# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# YCloud fallback (demo tenants can inherit these)
YCLOUD_API_KEY=
YCLOUD_WHATSAPP_FROM=+15553082749

# Welcome must be a Meta-approved template (outside 24h customer-care window)
YCLOUD_WELCOME_TEMPLATE_NAME=hello_world
YCLOUD_WELCOME_TEMPLATE_LANG=en
# set true if your template body has {{1}} for the lead name
YCLOUD_WELCOME_TEMPLATE_HAS_NAME=false

# LLM (Vercel AI SDK / OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
