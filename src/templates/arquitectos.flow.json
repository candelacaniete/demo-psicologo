{
  "niche": "arquitectos",
  "name": "Calificación estudio de arquitectura",
  "welcomeStepId": "welcome",
  "steps": [
    {
      "id": "welcome",
      "botMessage": "Hola {{collected_data.nombre}}, soy el asistente del estudio. ¿Qué tipo de proyecto tenés en mente?",
